# Copy to .env and adjust. Never commit .env.
# Every variable the backend reads is listed here (a test enforces that).

# development | test | production. Production demands a real SECRET_KEY.
APP_ENV=development

# SQLAlchemy URL. On Render this is injected from the database; postgres:// is rewritten automatically.
DATABASE_URL=postgresql+psycopg2://baton:baton@localhost:5432/baton

# Signs login sessions. At least 32 random characters in production (python -c "import secrets; print(secrets.token_urlsafe(48))").
# If empty outside production, a random key is used and sessions end when the server restarts.
SECRET_KEY=

# Session lifetime in minutes, and bcrypt cost (12 in production; tests use 4).
ACCESS_TOKEN_MINUTES=480
BCRYPT_ROUNDS=12

# Send the session cookie over HTTPS only. Set to false for plain http://localhost.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API directly. Leave empty when the frontend proxies /api/*.
ALLOWED_ORIGINS=

# Largest accepted upload in bytes (at most 1048576, so uploads are never spooled to disk).
MAX_UPLOAD_BYTES=1000000

# true: tell viewers how many items are withheld from them. false: show a generic notice without a number.
SHOW_WITHHELD_COUNT=true

# true: create the demo users and ingest demo-data/ on start (idempotent). Needs DEMO_PASSWORD.
DEMO_MODE=false
DEMO_PASSWORD=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# AI extraction over OpenRouter's free models. Leave OPENROUTER_API_KEY empty to run the
# deterministic fallback extractor instead of calling an API.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_SECONDS=120

# A claim is stale when its newest evidence is older than this many days before the project's as_of date.
STALE_AFTER_DAYS=365
